---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
  image?: string;
}

const { title, description, pubDate, slug, tags = [], image } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
---

<article class="news-card">
  <a href={`/noticias/${slug}/`}>
    {image && <img src={image} alt={title} class="card-image" />}
    <div class="card-body">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <h2>{title}</h2>
      <p>{description}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .news-card {
    background: #1e293b;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid #334155;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
  }

  .news-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .card-body {
    padding: 1.5rem;
  }

  time {
    font-size: 0.8rem;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }

  h2 {
    color: #f1f5f9;
    font-size: 1.25rem;
    margin: 0.5rem 0;
    line-height: 1.4;
  }

  p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: #0f172a;
    color: #38bdf8;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    border: 1px solid #1e40af;
  }
</style>
