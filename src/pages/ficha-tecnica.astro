---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { modelos } from '../data/modelos.js';

// Slug a partir do nome do modelo (para âncora)
function slugify(s) {
  return s
    .toString()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

// Monta dados prontos para o template
const modelosComMeta = modelos.map((m) => {
  const slug = slugify(m.nome);
  const url = new URL(`/ficha-tecnica#${slug}`, Astro.site).href;
  const shareText = `Confira a ficha técnica do ${m.nome} (${m.marca}) — Guia do Autopropelido`;
  return { ...m, slug, url, shareText };
});

// ============================================
// SCHEMA ITEMLIST com cada modelo como Product/Vehicle
// ============================================
const schemaFicha = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Ficha Técnica — Autopropelidos",
  "description": "Especificações técnicas dos principais modelos de autopropelidos disponíveis no mercado.",
  "itemListElement": modelosComMeta.map((m, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": ["Product", "Vehicle"],
      "name": m.nome,
      "description": m.descricao,
      "image": m.imagem,
      "url": m.url,
      "brand": {
        "@type": "Brand",
        "name": m.marca,
      },
      "additionalProperty": m.especificacoes.map((e) => ({
        "@type": "PropertyValue",
        "name": e.label,
        "value": e.valor,
      })),
    },
  })),
};
---

<BaseLayout
  title="Ficha Técnica — Guia do Autopropelido"
  description="Especificações técnicas dos principais modelos de autopropelidos: autonomia, velocidade, bateria, potência e mais."
>
  <SchemaOrg slot="head" schema={schemaFicha} />

  <section class="ficha-page">
    <Breadcrumbs
      items={[
        { label: 'Início', href: '/' },
        { label: 'Ficha Técnica' },
      ]}
    />

    <header class="ficha-header">
      <h1>Ficha Técnica</h1>
      <p>Especificações técnicas dos principais modelos de autopropelidos do mercado.</p>
    </header>

    <div class="ficha-lista">
      {modelosComMeta.map((modelo, i) => (
        <article class="ficha-card" id={modelo.slug}>
          <div class="ficha-imagem">
            <img
              src={modelo.imagem}
              alt={`Autopropelido ${modelo.nome} da marca ${modelo.marca}`}
              loading={i === 0 ? 'eager' : 'lazy'}
              width="1200"
              height="675"
            />
          </div>

          <div class="ficha-conteudo">
            <header class="ficha-card-header">
              <h2 class="ficha-modelo">{modelo.nome}</h2>
              <span class="ficha-marca">{modelo.marca}</span>
            </header>

            <p class="ficha-descricao">{modelo.descricao}</p>

            <table class="ficha-tabela">
              <tbody>
                {modelo.especificacoes.map((item, idx) => (
                  <tr class={idx % 2 === 0 ? 'ficha-linha-par' : ''}>
                    <td class="ficha-label">{item.label}</td>
                    <td class="ficha-valor">{item.valor}</td>
                  </tr>
                ))}
              </tbody>
            </table>

            <a class="ficha-busca" href={`/buscar?q=${encodeURIComponent(modelo.nome)}`}>
              Ver notícias sobre o {modelo.nome} →
            </a>

            <ShareButtons url={modelo.url} title={modelo.shareText} variant="compact" />
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
