---
import BaseLayout from '../layouts/BaseLayout.astro';

const especificacoes = [
  { label: 'Autonomia', valor: '120 km' },
  { label: 'Velocidade máxima', valor: '80 km/h' },
  { label: 'Tempo de recarga', valor: '45 min (80%)' },
  { label: 'Nível de autonomia', valor: '4' },
  { label: 'Sensores', valor: 'LiDAR 360°, câmeras HD, radar' },
  { label: 'Conectividade', valor: '5G, Wi-Fi, Bluetooth' },
  { label: 'Capacidade', valor: '4 passageiros' },
  { label: 'Peso', valor: '1.200 kg' },
];
---

<BaseLayout title="Ficha Técnica — Guia do Autopropelido">
  <section style="margin: 40px 0;">
    <h1 style="font-size: 2rem; margin-bottom: 8px;">Ficha Técnica</h1>
    <p style="color: #666; margin-bottom: 32px;">Especificações do modelo de referência XZ-4000.</p>

    <table style="width: 100%; border-collapse: collapse; max-width: 720px;">
      <tbody>
        {especificacoes.map((item, i) => (
          <tr style={i % 2 === 0 ? 'background: #f9f9f9;' : ''}>
            <td style="padding: 12px 16px; font-weight: 600; border: 1px solid #e0e0e0; width: 40%;">{item.label}</td>
            <td style="padding: 12px 16px; border: 1px solid #e0e0e0;">{item.valor}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>
