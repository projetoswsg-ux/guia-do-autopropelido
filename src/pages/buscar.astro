---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { modelos } from '../data/modelos.js';  

const noticias = await getCollection('noticias');

// Índice das notícias (automático)
const indiceNoticias = noticias.map((n) => ({
  tipo: 'noticia',
  title: n.data.title,
  description: n.data.description,
  slug: n.slug,
  url: `/noticias/${n.slug}`,
  date: n.data.date,
  category: n.data.category,
  image: n.data.image || '',
  body: (n.body || '')
    .replace(/[#*_>`\[\]()!-]/g, ' ')
    .replace(/\s+/g, ' ')
    .slice(0, 500),
}));

// Índice dos modelos da ficha técnica (automático)
const indiceModelos = modelos.map((m) => {
  // Junta as especificações em texto para facilitar a busca
  const especsTexto = m.especificacoes
    .map((e) => `${e.label} ${e.valor}`)
    .join(' ');

  return {
    tipo: 'modelo',
    title: `${m.nome} — ${m.marca}`,
    description: m.descricao,
    url: '/ficha-tecnica',
    date: '',
    category: 'Ficha Técnica',
    image: m.imagem,
    body: `modelo ficha tecnica especificacoes ${m.nome} ${m.marca} ${especsTexto}`,
  };
});

// Índice das páginas estáticas (manual)
const paginas = [
  {
    tipo: 'pagina',
    title: 'Trend — Últimas notícias',
    description: 'Lista cronológica de todas as notícias publicadas sobre autopropelidos.',
    url: '/trend',
    date: '',
    category: 'Página',
    image: '',
    body: 'trend ultimas noticias lista cronologica publicacoes recentes novidades',
  },
  {
    tipo: 'pagina',
    title: 'Marcas de autopropelidos',
    description: 'Principais fabricantes de autopropelidos no Brasil e no mundo.',
    url: '/marcas',
    date: '',
    category: 'Página',
    image: '',
    body: 'marcas fabricantes empresas modelos xz motors autonova voltride motochefe',
  },
  {
    tipo: 'pagina',
    title: 'Ficha técnica',
    description: 'Especificações técnicas dos modelos de autopropelidos: autonomia, velocidade, sensores.',
    url: '/ficha-tecnica',
    date: '',
    category: 'Página',
    image: '',
    body: 'ficha tecnica especificacoes autonomia velocidade recarga sensores lidar 5g capacidade peso modelos',
  },
  {
    tipo: 'pagina',
    title: 'Fale conosco',
    description: 'Entre em contato com a redação do Guia do Autopropelido.',
    url: '/fale-conosco',
    date: '',
    category: 'Página',
    image: '',
    body: 'contato fale conosco email mensagem sugestao pauta anuncio publicidade redacao',
  },
  {
    tipo: 'pagina',
    title: 'Política de privacidade',
    description: 'Como o Guia do Autopropelido trata seus dados e informações.',
    url: '/privacidade',
    date: '',
    category: 'Página',
    image: '',
    body: 'privacidade politica dados cookies lgpd termos uso informacoes pessoais',
  },
];

const indice = [...indiceNoticias, ...indiceModelos, ...paginas];
---

<BaseLayout title="Buscar — Guia do Autopropelido" description="Busque notícias, marcas, modelos e páginas no Guia do Autopropelido">
  <section class="search-page">
    <h1 class="search-heading">Buscar</h1>
    <p class="search-subtitle">Encontre notícias, modelos, marcas e páginas do site.</p>

    <form class="search-page-form" id="search-page-form" role="search">
      <input
        type="search"
        id="search-input"
        name="q"
        placeholder="Digite um termo: modelo, marca, ficha técnica..."
        aria-label="Buscar no site"
        autocomplete="off"
        autofocus
      />
      <button type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
      </button>
    </form>

    <p class="search-status" id="search-status">Digite algo para começar.</p>
    <div class="search-results" id="search-results"></div>
  </section>

  <script define:vars={{ indice }}>
    const input = document.getElementById('search-input');
    const form = document.getElementById('search-page-form');
    const results = document.getElementById('search-results');
    const status = document.getElementById('search-status');

    function norm(s) {
      return (s || '')
        .toString()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    const indiceNorm = indice.map((item) => ({
      ...item,
      haystack: norm(`${item.title} ${item.description} ${item.category} ${item.body}`),
    }));

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c]));
    }

    function renderCard(item) {
      const thumb = item.image
        ? `<div class="search-thumb"><img src="${escapeHtml(item.image)}" alt="" loading="lazy"></div>`
        : `<div class="search-thumb search-thumb-page"><span>${item.tipo === 'pagina' ? 'Página' : ''}</span></div>`;

      const dateLine = item.date
        ? `<span class="search-date">${escapeHtml(item.date)}</span>`
        : '';

      return `
        <a href="${escapeHtml(item.url)}" class="search-card">
          ${thumb}
          <div class="search-info">
            <span class="search-category">${escapeHtml(item.category)}</span>
            <h3>${escapeHtml(item.title)}</h3>
            <p>${escapeHtml(item.description)}</p>
            ${dateLine}
          </div>
        </a>
      `;
    }

    function buscar(termo) {
      const q = norm(termo.trim());
      if (!q) {
        results.innerHTML = '';
        status.textContent = 'Digite algo para começar.';
        return;
      }

      const matches = indiceNorm.filter((item) => item.haystack.includes(q));

      if (matches.length === 0) {
        results.innerHTML = '';
        status.textContent = `Nenhum resultado para "${termo}".`;
        return;
      }

      // Ordena: páginas e modelos primeiro, notícias depois (mais recentes primeiro)
      matches.sort((a, b) => {
        const peso = { pagina: 0, modelo: 1, noticia: 2 };
        if (peso[a.tipo] !== peso[b.tipo]) return peso[a.tipo] - peso[b.tipo];
        return (b.date || '').localeCompare(a.date || '');
      });

      status.textContent = `${matches.length} resultado${matches.length > 1 ? 's' : ''} para "${termo}"`;
      results.innerHTML = matches.map(renderCard).join('');
    }

    const params = new URLSearchParams(window.location.search);
    const qInicial = params.get('q') || '';
    if (qInicial) {
      input.value = qInicial;
      buscar(qInicial);
    }

    input.addEventListener('input', (e) => buscar(e.target.value));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const termo = input.value;
      buscar(termo);
      const url = new URL(window.location);
      if (termo) {
        url.searchParams.set('q', termo);
      } else {
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
    });
  </script>
</BaseLayout>
