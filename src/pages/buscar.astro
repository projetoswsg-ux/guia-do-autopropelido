---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const noticias = await getCollection('noticias');

// Índice enxuto que vai embutido na página
const indice = noticias.map((n) => ({
  title: n.data.title,
  description: n.data.description,
  slug: n.slug,
  date: n.data.date,
  category: n.data.category,
  image: n.data.image || '',
  // primeiros 500 caracteres do corpo, sem markdown pesado
  body: (n.body || '')
    .replace(/[#*_>`\[\]()!-]/g, ' ')
    .replace(/\s+/g, ' ')
    .slice(0, 500),
}));
---

<BaseLayout title="Buscar — Guia do Autopropelido" description="Busque notícias, marcas e modelos no Guia do Autopropelido">
  <section class="search-page">
    <h1 class="search-heading">Buscar</h1>
    <p class="search-subtitle">Encontre notícias, modelos e marcas de autopropelidos.</p>

    <form class="search-page-form" id="search-page-form" role="search">
      <input
        type="search"
        id="search-input"
        name="q"
        placeholder="Digite um termo: modelo, marca, tema..."
        aria-label="Buscar no site"
        autocomplete="off"
        autofocus
      />
      <button type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
      </button>
    </form>

    <p class="search-status" id="search-status">Digite algo para começar.</p>
    <div class="search-results" id="search-results"></div>
  </section>

  <script define:vars={{ indice }}>
    const input = document.getElementById('search-input');
    const form = document.getElementById('search-page-form');
    const results = document.getElementById('search-results');
    const status = document.getElementById('search-status');

    // Normaliza texto: minúsculas + remove acentos
    function norm(s) {
      return (s || '')
        .toString()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    // Pré-processa o índice (evita normalizar toda vez)
    const indiceNorm = indice.map((item) => ({
      ...item,
      haystack: norm(`${item.title} ${item.description} ${item.category} ${item.body}`),
    }));

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c]));
    }

    function renderCard(item) {
      const thumb = item.image
        ? `<div class="search-thumb"><img src="${escapeHtml(item.image)}" alt="" loading="lazy"></div>`
        : '';
      return `
        <a href="/noticias/${escapeHtml(item.slug)}" class="search-card">
          ${thumb}
          <div class="search-info">
            <span class="search-category">${escapeHtml(item.category)}</span>
            <h3>${escapeHtml(item.title)}</h3>
            <p>${escapeHtml(item.description)}</p>
            <span class="search-date">${escapeHtml(item.date)}</span>
          </div>
        </a>
      `;
    }

    function buscar(termo) {
      const q = norm(termo.trim());
      if (!q) {
        results.innerHTML = '';
        status.textContent = 'Digite algo para começar.';
        return;
      }

      const matches = indiceNorm.filter((item) => item.haystack.includes(q));

      if (matches.length === 0) {
        results.innerHTML = '';
        status.textContent = `Nenhum resultado para "${termo}".`;
        return;
      }

      status.textContent = `${matches.length} resultado${matches.length > 1 ? 's' : ''} para "${termo}"`;
      results.innerHTML = matches.map(renderCard).join('');
    }

    // Lê o parâmetro ?q= da URL
    const params = new URLSearchParams(window.location.search);
    const qInicial = params.get('q') || '';
    if (qInicial) {
      input.value = qInicial;
      buscar(qInicial);
    }

    // Filtro em tempo real
    input.addEventListener('input', (e) => buscar(e.target.value));

    // Atualiza a URL ao enviar o formulário (para poder compartilhar o link)
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const termo = input.value;
      buscar(termo);
      const url = new URL(window.location);
      if (termo) {
        url.searchParams.set('q', termo);
      } else {
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
    });
  </script>
</BaseLayout>
