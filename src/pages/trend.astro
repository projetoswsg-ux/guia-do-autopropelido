---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';

const noticias = await getCollection('noticias');
const todas = noticias.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Trend — Guia do Autopropelido">
  <section style="margin: 40px 0;">
    <h1 style="font-size: 2rem; margin-bottom: 8px;">Trend</h1>
    <p style="color: #666; margin-bottom: 32px;">Todas as notícias publicadas, em ordem cronológica.</p>

    <div class="news-grid">
      {todas.map((noticia) => (
        <NewsCard
          title={noticia.data.title}
          description={noticia.data.description}
          image={noticia.data.image}
          date={noticia.data.date}
          slug={noticia.slug}
        />
      ))}
    </div>

    {todas.length === 0 && <p>Nenhuma notícia publicada ainda.</p>}
  </section>
</BaseLayout>
