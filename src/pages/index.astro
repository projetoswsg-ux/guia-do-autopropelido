---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';

const noticias = (await getCollection('noticias', ({ data }) => {
  return data.draft !== true;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Início">
  <Header />
  <main>
    <section class="hero">
      <h1>Guia do <span>Autopropelido</span></h1>
      <p>As últimas notícias sobre mobilidade elétrica, regulamentação e inovação.</p>
    </section>

    <section class="news-grid">
      {noticias.map(noticia => (
        <NewsCard
          title={noticia.data.title}
          description={noticia.data.description}
          pubDate={noticia.data.pubDate}
          slug={noticia.slug}
          tags={noticia.data.tags}
          image={noticia.data.image}
        />
      ))}
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 1.5rem 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    color: #f1f5f9;
    margin: 0 0 1rem;
    font-weight: 800;
    letter-spacing: -1px;
  }

  .hero h1 span {
    color: #38bdf8;
  }

  .hero p {
    color: #94a3b8;
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .news-grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }
</style>
