---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedNews from '../../components/RelatedNews.astro';
import StructuredData from '../../components/StructuredData.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await noticia.render();

const todas = await getCollection('noticias');
const ultimas = todas
  .filter((n) => n.slug !== noticia.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
---

<BaseLayout
  title={`${noticia.data.title} — Guia do Autopropelido`}
  description={noticia.data.description}
  image={noticia.data.image}
>
  <StructuredData slot="head" noticia={noticia} />

  <article style="max-width: 800px; margin: 40px auto;">
    <header class="article-header">
      <h1>{noticia.data.title}</h1>
      <div class="article-meta">
        {noticia.data.author} · {noticia.data.date} · {noticia.data.category}
      </div>
    </header>

    {noticia.data.image && (
      <img src={noticia.data.image} alt={noticia.data.title} class="article-hero" />
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>

  <RelatedNews noticias={ultimas} titulo="Últimas notícias" />
</BaseLayout>
