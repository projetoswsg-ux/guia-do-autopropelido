---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fale Conosco — Guia do Autopropelido">
  <section class="page-content">
    <h1>Fale Conosco</h1>
    <p style="margin-bottom: 24px;">Tem uma sugestão de pauta, dúvida ou quer anunciar? Entre em contato.</p>

    <form style="display: grid; gap: 16px; max-width: 480px;">
      <div>
        <label for="nome" style="display: block; font-weight: 600; margin-bottom: 4px;">Nome</label>
        <input type="text" id="nome" name="nome" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;" />
      </div>
      <div>
        <label for="email" style="display: block; font-weight: 600; margin-bottom: 4px;">E-mail</label>
        <input type="email" id="email" name="email" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;" />
      </div>
      <div>
        <label for="mensagem" style="display: block; font-weight: 600; margin-bottom: 4px;">Mensagem</label>
        <textarea id="mensagem" name="mensagem" rows="5" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;"></textarea>
      </div>
      <button type="submit" style="padding: 12px 24px; background: #1a1a1a; color: #fff; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">
        Enviar
      </button>
    </form>
  </section>
</BaseLayout>
